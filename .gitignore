.Ruserdata

/.quarto/

**/*.quarto_ipynb

# IPUMS extracts are large and require an account to download. The extract stays
# local; blog/posts/post3/data/derived/ holds the aggregated tables.
blog/posts/post3/data/raw/*.dat.gz
blog/posts/post3/data/raw/*.dat
blog/posts/post3/data/raw/*.xml

# PSID data cannot be redistributed. Raw downloads and prepared CSVs for post 6 stay
# local; only the rendered page is published.
blog/posts/post6/data/raw/
blog/posts/post6/data/psid/

# Local preview config for Claude Code, not part of the site
.claude/

# Class materials for post 9 (stock game results) stay local; only anonymous
# derived returns are committed.
blog/posts/post9/data/course/
# Yahoo Finance prices for post 9 are re-downloadable and not redistributed.
blog/posts/post9/data/raw/prices.csv.gz
blog/posts/post9/data/raw/spy.csv.gz
